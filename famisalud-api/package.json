{
  "name": "famisalud-api",
  "version": "1.0.0",
  "description": "API REST de FamiSalud con Node.js, Express y PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.1.0",
    "multer": "2.3.0",
    "node-cron": "^4.6.0",
    "pg": "8.23.0",
    "zod": "4.5.4"
  }
}
